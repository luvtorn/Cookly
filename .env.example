# Optional for the foundation. Required before database access or migrations.
DATABASE_URL=
# Required for auth operations: a cryptographically random secret (32+ characters).
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Required for Cloudinary operations, not for offline checks/builds.
# The API key needs resource Create/Upload permission; successful ping alone is insufficient.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
