{
  "name": "cookly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "test:db:migrate": "node scripts/migrate-test-database.mjs",
    "auth:preflight": "node scripts/check-auth-identities.mjs",
    "admin:create": "node --experimental-strip-types scripts/create-admin.mjs --show-credentials",
    "seed:editorial": "node scripts/seed-editorial.mjs",
    "images:editorial": "node scripts/upload-editorial-images.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "preprisma:migrate": "node --experimental-strip-types scripts/require-database.mjs",
    "prisma:migrate": "prisma migrate dev",
    "preprisma:deploy": "node --experimental-strip-types scripts/require-database.mjs",
    "prisma:deploy": "prisma migrate deploy",
    "preprisma:studio": "node --experimental-strip-types scripts/require-database.mjs",
    "prisma:studio": "prisma studio",
    "cloudinary:check": "node --experimental-strip-types scripts/check-cloudinary.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "16.3.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
